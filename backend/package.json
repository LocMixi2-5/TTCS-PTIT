{
  "name": "job-recommender-backend",
  "version": "1.0.0",
  "description": "Node.js API Gateway for Job Recommender System",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "knex migrate:latest --knexfile src/config/knexfile.js",
