    "seed": "node src/config/seed.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.13.0",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "axios": "^1.7.7",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}